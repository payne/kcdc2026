#!/usr/bin/env python3
"""
pre-commit hook: bump docs/data/version.json's builtAt timestamp to now
and fold that change into the commit being made.

Does NOT recompute dataVersion/appVersion/file hashes — run
build_version.py for that after actually changing data or app-shell files.
"""
from __future__ import annotations

import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path

VERSION_FILE = Path("docs/data/version.json")


def main() -> int:
    if not VERSION_FILE.exists():
        return 0

    version = json.loads(VERSION_FILE.read_text())
    version["builtAt"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    VERSION_FILE.write_text(json.dumps(version, indent=2) + "\n")
    subprocess.run(["git", "add", str(VERSION_FILE)], check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
